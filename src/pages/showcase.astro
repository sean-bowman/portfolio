---
/* ========================================
   SHOWCASE PAGE
   Interactive 3D models generated by my repositories
   Sean Bowman [10/05/2026]
   ======================================== */

import BaseLayout from '../layouts/BaseLayout.astro';
import { showcaseModels } from '../data/models.js';
import '../styles/showcase.css';

/** Button labels for each render mode */
const modeLabels = { solid: 'Solid', jacket: 'Cooling jacket', lines: 'Lines' };
---

<BaseLayout
    title="Showcase"
    description="Interactive 3D models generated by my engineering repositories, starting with a regeneratively cooled rocket nozzle from NOVA."
    current="showcase"
>
    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1 class="page-title">3D Showcase</h1>
            <p class="page-description">
                Geometry generated by my own code, rendered in the browser. Drag to orbit; Ctrl and scroll, or pinch, to zoom; right-drag to pan.
            </p>
        </div>
    </section>

    <!-- One card per entry in src/data/models.js; one shared canvas draws every card -->
    <section class="showcase-section">
        <div class="container">
            <div class="showcase-layout">
                <div class="showcase-grid">
                    {showcaseModels.map((model, index) => (
                        <article class:list={['showcase-card', { 'is-wide': model.wide }]} data-model-index={index}>
                            <div class="showcase-view" role="img" aria-label={`3D model: ${model.name}`}>
                                <div class="showcase-loading">
                                    <div class="loading"></div>
                                    <p>Loading model...</p>
                                </div>
                            </div>
                            <div class="showcase-content">
                                <h2 class="showcase-title">{model.name}</h2>
                                <p class="showcase-description">{model.description}</p>
                                <dl class="showcase-specs">
                                    {model.specs.map(spec => (
                                        <div class="showcase-spec">
                                            <dt>{spec.label}</dt>
                                            <dd>{spec.value}</dd>
                                        </div>
                                    ))}
                                </dl>
                                {model.note && (
                                    <p class="showcase-note">
                                        {model.note}
                                        {model.noteUrl && <> <a href={model.noteUrl} target="_blank" rel="noopener noreferrer">Validation status</a></>}
                                    </p>
                                )}
                                <div class="showcase-controls">
                                    <div class="showcase-modes" role="group" aria-label="Render mode">
                                        {model.modes.map((mode, modeIndex) => (
                                            <button type="button" class="showcase-mode" data-mode={mode} aria-pressed={modeIndex === 0 ? 'true' : 'false'}>
                                                {modeLabels[mode as keyof typeof modeLabels] ?? mode}
                                            </button>
                                        ))}
                                    </div>
                                    <button type="button" class="showcase-mode showcase-reset" data-reset>Reset view</button>
                                </div>
                                <a class="showcase-source" href={model.sourceUrl} target="_blank" rel="noopener noreferrer">
                                    Source: {model.sourceLabel}
                                </a>
                            </div>
                        </article>
                    ))}
                </div>
                <div class="showcase-stage" aria-hidden="true">
                    <canvas class="showcase-canvas"></canvas>
                </div>
            </div>
        </div>
    </section>

    <script>
        // Three.js and the viewer load in idle time once the grid nears the viewport, so the
        // page's text is interactive first. Runs once per visit; the client router fires
        // astro:page-load on every arrival at the page.
        function loadViewer() {
            const layout = /** @type {HTMLElement | null} */ (document.querySelector('.showcase-layout'));
            if (!layout || layout.dataset.loading === 'true') return;
            layout.dataset.loading = 'true';

            const observer = new IntersectionObserver((entries) => {
                if (!entries.some(entry => entry.isIntersecting)) return;
                observer.disconnect();
                const start = () => {
                    import('../scripts/showcase/viewer.js')
                        .then(module => module.initShowcase())
                        .catch(error => {
                            console.warn('Showcase viewer unavailable:', error instanceof Error ? error.message : error);
                            layout.classList.add('is-unsupported');
                            layout.querySelectorAll('.showcase-loading').forEach(element => {
                                element.textContent = 'This browser could not start the 3D view.';
                            });
                        });
                };
                if ('requestIdleCallback' in window) window.requestIdleCallback(start, { timeout: 1500 });
                else window.setTimeout(start, 200);
            }, { rootMargin: '400px 0px' });
            observer.observe(layout);
        }

        document.addEventListener('astro:page-load', loadViewer);
        // This script can first run after the navigation's page-load event; the loading
        // flag makes the second call safe
        loadViewer();
    </script>
</BaseLayout>
