---
/* ========================================
   GLYPH: REGENERATIVELY COOLED NOZZLE
   Aerospace Engineer II role: coolant climbing helical channels from exit to chamber
   Sean Bowman [10/06/2026]
   ======================================== */

// Generic geometry: chamber, throat, and bell drawn as cubic Beziers in a 48-unit
// viewBox. The channel lines are generated from that same contour: 10 helical channels,
// 0.42 turns from exit to chamber, front half only, rounded to 0.1. Each path runs from
// the exit upward, so the dash animation moves coolant toward the chamber.
const channelPaths = [
    'M24.0 41.6 L25.8 39.8 L27.1 38.0 L28.1 36.3 L28.7 34.5 L28.9 32.7 L28.9 30.9 L28.6 29.1 L28.1 27.4 L27.6 25.6 L27.1 23.8 L26.7 22.0 L26.6 21.1',
    'M32.6 41.6 L33.2 39.8 L33.4 38.0 L33.1 36.3 L32.6 34.5 L31.8 32.7 L30.8 30.9 L30.0 29.6',
    'M38.0 41.6 L37.2 39.8 L36.0 38.0',
    'M17.0 11.1 L17.1 9.3 L17.4 7.6 L17.7 6.0',
    'M21.5 19.6 L20.9 17.8 L19.6 16.0 L18.4 14.2 L18.2 12.5 L18.7 10.7 L19.4 8.9 L20.1 7.1 L20.6 6.0',
    'M18.9 28.0 L19.9 26.2 L20.7 24.5 L21.4 22.7 L21.9 20.9 L22.1 19.1 L21.7 17.3 L21.2 15.6 L21.2 13.8 L21.8 12.0 L22.7 10.2 L23.6 8.4 L24.5 6.7 L24.9 6.0',
    'M13.2 36.5 L14.7 34.7 L16.2 32.9 L17.7 31.1 L19.1 29.4 L20.4 27.6 L21.4 25.8 L22.2 24.0 L22.8 22.2 L23.2 20.5 L23.5 18.7 L23.8 16.9 L24.4 15.1 L25.4 13.3 L26.3 11.6 L27.2 9.8 L28.0 8.0 L28.7 6.2 L28.8 6.0',
    'M10.0 41.6 L11.9 39.8 L13.9 38.0 L15.9 36.3 L17.8 34.5 L19.5 32.7 L20.9 30.9 L22.1 29.1 L23.0 27.4 L23.7 25.6 L24.2 23.8 L24.5 22.0 L24.8 20.2 L25.2 18.5 L26.3 16.7 L27.8 14.9 L29.1 13.1 L29.8 11.3 L30.3 9.6 L30.6 7.8 L30.9 6.0',
    'M15.4 41.6 L17.6 39.8 L19.7 38.0 L21.5 36.3 L23.1 34.5 L24.3 32.7 L25.1 30.9 L25.7 29.1 L26.0 27.4 L26.1 25.6 L26.1 23.8 L26.0 22.0 L26.1 20.2 L26.4 18.5 L27.8 16.7 L29.6 14.9 L30.8 13.1 L30.9 12.7'
];
---

<svg class="glyph" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-draw data-loops>
    <!-- Shaded right half -->
    <path d="M24 4 H31 V12 C31 15 26.5 17 26.5 19.5 C26.5 27 34 35 39 42 H24 Z" fill="currentColor" fill-opacity="0.07" stroke="none" />

    <!-- Injector flange, chamber, throat, bell -->
    <path d="M15.5 3 H32.5 V5 H15.5 Z" stroke-width="0.8" />
    <path d="M17 5 V12 C17 15 21.5 17 21.5 19.5 C21.5 27 14 35 9 42" stroke-width="1" />
    <path d="M31 5 V12 C31 15 26.5 17 26.5 19.5 C26.5 27 34 35 39 42" stroke-width="1" />
    <ellipse cx="24" cy="42" rx="15" ry="1.8" stroke-width="0.9" />

    <!-- Coolant inlet manifold near the exit -->
    <ellipse cx="24" cy="40.2" rx="14" ry="1.5" stroke-width="0.5" stroke-opacity="0.6" />
    <path d="M38.3 39.6 H43 V36.5" stroke-width="0.7" />

    <!-- Helical channels -->
    {channelPaths.map(d => <path class="rn-channel" d={d} />)}

    <!-- Coolant moving up the channels -->
    <g class="rn-coolant" data-loop>
        {channelPaths.map(d => <path d={d} />)}
    </g>

    <!-- Faint plume below the exit -->
    <g class="rn-plume" data-loop>
        <path class="flame-outer" d="M12 43.4 C17 45.6 21 47.4 24 48.4 C27 47.4 31 45.6 36 43.4 Z" />
    </g>
</svg>
