---
/* ========================================
   GLYPH: REGENERATIVELY COOLED NOZZLE
   Aerospace Engineer II role: coolant climbing helical channels from exit to chamber
   Sean Bowman [10/06/2026]
   ======================================== */

// The wall is NOVA's worked-example contour (src/lib/novaOutline.js) in its true radial
// proportions, shortened along the axis, standing exit-down in a 48-unit viewBox with room
// below for the plume. The channel lines are generated from the same wall: 10 helical
// channels, 0.42 turns from exit to chamber, front half only, rounded to 0.1. Each path runs
// from the exit upward, so the dash animation moves coolant toward the chamber.

import { halfWidthAt, novaRatios, pathData, round, wallPoints } from '../../lib/novaOutline.js';

const axis = 24;
const throatHalf = 1.8;
/** @type {import('../../lib/novaOutline.js').OutlineSpec} */
const spec = {
    chamberAt: 4,
    convergeAt: 7.6,
    throatAt: 11,
    exitAt: 35.4,
    chamberHalf: throatHalf * novaRatios.chamber,
    throatHalf,
    exitHalf: throatHalf * novaRatios.exit,
    axis,
    vertical: true
};

const leftWall = pathData(wallPoints(spec, -1));
const rightPoints = wallPoints(spec, 1);
const rightWall = pathData(rightPoints);
const shadedHalf = `${pathData([[axis, spec.chamberAt], ...rightPoints, [axis, spec.exitAt]])} Z`;
const flangeHalf = spec.chamberHalf + 1.6;
const manifoldY = spec.exitAt - 1.8;

/**
 * Front-half traces of helical channels on the wall, each running from the exit to the
 * chamber.
 * @returns {string[]}
 */
function channelPaths() {
    const count = 10;
    const turns = 0.42;
    const steps = 160;
    const yExit = spec.exitAt - 0.4;
    const yTop = spec.chamberAt + 1.5;
    /** @type {string[]} */
    const paths = [];
    for (let k = 0; k < count; k++) {
        const theta0 = 2 * Math.PI * k / count;
        /** @type {[number, number][][]} */
        const segments = [];
        /** @type {[number, number][]} */
        let segment = [];
        for (let i = 0; i <= steps; i++) {
            const y = yExit - (yExit - yTop) * i / steps;
            const theta = theta0 + 2 * Math.PI * turns * i / steps;
            if (Math.cos(theta) > 0.05) {
                segment.push([axis + halfWidthAt(spec, y) * Math.sin(theta), y]);
            } else if (segment.length) {
                segments.push(segment);
                segment = [];
            }
        }
        if (segment.length) segments.push(segment);
        segments.filter(points => points.length >= 6).forEach(points => {
            // Every eighth point is smooth enough at this scale
            const thinned = points.filter((_, i) => i % 8 === 0);
            if ((points.length - 1) % 8) thinned.push(points[points.length - 1]);
            paths.push(pathData(thinned));
        });
    }
    return paths;
}
const channels = channelPaths();

// Plume from the exit plane to the foot of the viewBox: outer, mid, and core layers
const plumeTop = spec.exitAt + 0.6;
/**
 * @param {number} half - Half-width at the exit
 * @param {number} tip - Height of the tip
 */
function flame(half, tip) {
    const length = tip - plumeTop;
    return `M${round(axis - half)} ${plumeTop} C${round(axis - half * 0.7)} ${round(plumeTop + length * 0.4)} ${round(axis - half * 0.3)} ${round(plumeTop + length * 0.8)} ${axis} ${tip} `
        + `C${round(axis + half * 0.3)} ${round(plumeTop + length * 0.8)} ${round(axis + half * 0.7)} ${round(plumeTop + length * 0.4)} ${round(axis + half)} ${plumeTop} Z`;
}
---

<svg class="glyph" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-draw data-loops>
    <!-- Shaded right half -->
    <path d={shadedHalf} fill="currentColor" fill-opacity="0.07" stroke="none" />

    <!-- Injector flange, then chamber, throat, and bell on each side -->
    <path d={`M${round(axis - flangeHalf)} 2.4 H${round(axis + flangeHalf)} V${spec.chamberAt} H${round(axis - flangeHalf)} Z`} stroke-width="0.8" />
    <path d={leftWall} stroke-width="1" />
    <path d={rightWall} stroke-width="1" />
    <ellipse cx={axis} cy={spec.exitAt} rx={round(spec.exitHalf)} ry="1.6" stroke-width="0.9" />

    <!-- Coolant inlet manifold near the exit -->
    <ellipse cx={axis} cy={manifoldY} rx={round(halfWidthAt(spec, manifoldY) - 0.4)} ry="1.4" stroke-width="0.5" stroke-opacity="0.6" />

    <!-- Helical channels -->
    {channels.map(d => <path class="rn-channel" d={d} />)}

    <!-- Coolant moving up the channels -->
    <g class="rn-coolant" data-loop>
        {channels.map(d => <path d={d} />)}
    </g>

    <!-- Plume below the exit -->
    <g class="rn-plume" data-loop>
        <path class="flame-outer" d={flame(spec.exitHalf - 1.3, 47.8)} />
        <path class="flame-mid" d={flame(spec.exitHalf * 0.62, 45)} />
        <path class="flame-core" d={flame(spec.exitHalf * 0.33, 41.2)} />
    </g>
</svg>
