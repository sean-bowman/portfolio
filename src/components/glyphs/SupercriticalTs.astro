---
/* ========================================
   GLYPH: SUPERCRITICAL T-s DIAGRAM
   Aerospace Engineer I role: a state point rides a supercritical isobar
   Sean Bowman [10/06/2026]
   ======================================== */

// Temperature-entropy axes and one supercritical isobar. The isobar is S-shaped: its slope
// dT/ds = T/cp is steep in the liquid-like region, flattens near the pseudo-critical point
// where cp peaks, and steepens again in the gas-like region. The state point is a
// round-capped near-zero dash on a pathLength="1" copy of the isobar, so a
// stroke-dashoffset animation moves it along the curve. 48-unit viewBox.
const supercriticalIsobar = 'M8.6 41 C10.4 32 14.6 18.5 20.5 13 C24 10 28.5 9.5 32.5 8.6 C37 7.4 40.5 5 43.5 1.8';
---

<svg class="glyph" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-draw data-loops>
    <!-- Axes -->
    <path d="M6 2 V42 H44" stroke-width="0.9" />
    <path d="M4.8 4 L6 2 L7.2 4 M42 40.8 L44 42 L42 43.2" stroke-width="0.7" />
    <text class="glyph-label" x="1.4" y="10">T</text>
    <text class="glyph-label" x="39.6" y="47.4">s</text>

    <!-- Supercritical isobar -->
    <path d={supercriticalIsobar} stroke-width="0.9" />

    <!-- State point -->
    <path class="ts-point" data-loop d={supercriticalIsobar} pathLength="1" />
</svg>
