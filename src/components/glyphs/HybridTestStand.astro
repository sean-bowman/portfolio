---
/* ========================================
   GLYPH: HYBRID TEST STAND
   Director of Propulsion role: a hybrid motor hot fire on a horizontal stand
   Sean Bowman [10/06/2026]
   ======================================== */

// Generic hardware: thrust wall, motor case on two A-frames, run tank, feed line with a
// valve symbol, plume with shock diamonds. The nozzle takes NOVA's worked-example contour
// (src/lib/novaOutline.js): converging from the case's aft end to the throat, then the bell
// at NOVA's exit-to-throat ratio, shortened along the axis. 48-unit viewBox. Cycle (6 s):
// ignition at 12 to 18%, burn, shutdown at 72 to 78%, then a vent wisp from the run tank.
// The plume starts just inside the exit plane, and its scale origin in glyphs.css (.hm-plume)
// sits there, at x = 38.6.

import { novaRatios, pathData, wallPoints } from '../../lib/novaOutline.js';

const throatHalf = 0.72;
/** @type {import('../../lib/novaOutline.js').OutlineSpec} */
const nozzle = {
    chamberAt: 30,
    convergeAt: 30,
    throatAt: 32.2,
    exitAt: 39,
    chamberHalf: 2.7,
    throatHalf,
    exitHalf: throatHalf * novaRatios.exit,
    axis: 23.5
};
const nozzleWalls = `${pathData(wallPoints(nozzle, -1))} ${pathData(wallPoints(nozzle, 1))}`;
---

<svg class="glyph" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-draw data-loops>
    <!-- Ground -->
    <path d="M3 40 H45" stroke-width="1" />
    <path d="M3 42.5 H30" stroke-width="0.5" stroke-opacity="0.45" />

    <!-- Thrust wall with light hatching -->
    <path d="M5 40 V15 H8 V40" stroke-width="0.9" />
    <path d="M5 20 L8 25 M5 30 L8 35" stroke-width="0.4" stroke-opacity="0.45" />

    <!-- Motor case (lower half shaded), segment joints -->
    <rect x="8" y="23.5" width="22" height="3.5" fill="currentColor" fill-opacity="0.1" stroke="none" />
    <rect x="8" y="20" width="22" height="7" rx="1.2" stroke-width="1" />
    <path d="M14 20 V27 M24 20 V27" stroke-width="0.4" stroke-opacity="0.5" />

    <!-- Nozzle: NOVA's converging section to the throat, then its bell to the exit -->
    <path d={nozzleWalls} stroke-width="0.9" />

    <!-- A-frame supports -->
    <path d="M11 40 L14 27 L17 40 M23 40 L26 27 L29 40" stroke-width="0.8" />

    <!-- Run tank on struts, feed line into the head end with a valve -->
    <rect x="11" y="7" width="15" height="6" rx="3" stroke-width="0.9" />
    <path d="M14 13 V20 M23 13 V20" stroke-width="0.5" />
    <path d="M11 10 H9.5 V16 M9.5 19 V20" stroke-width="0.8" />
    <path d="M8 16 H11 L8 19 H11 Z" stroke-width="0.6" />

    <!-- Vent wisp after shutdown -->
    <path class="hm-vent" data-loop d="M18.5 6.6 C17.8 5 19.4 4 18.8 2.2" stroke-width="0.6" />

    <!-- Plume with shock diamonds, from the exit plane -->
    <g class="hm-plume" data-loop>
        <path class="flame-outer" d="M38.6 19.2 C41.8 20 44.5 21.6 47.6 23.5 C44.5 25.4 41.8 27 38.6 27.8 Z" />
        <path class="flame-mid" d="M38.6 20.4 C41.3 21.3 43.2 22.4 45.4 23.5 C43.2 24.6 41.3 25.7 38.6 26.6 Z" />
        <path class="flame-core" d="M38.6 21.9 C40.5 22.5 41.8 23 43 23.5 C41.8 24 40.5 24.5 38.6 25.1 Z" />
        <path class="flame-diamond" d="M41.2 23.5 L41.9 22.9 L42.6 23.5 L41.9 24.1 Z M43.9 23.5 L44.5 23 L45.1 23.5 L44.5 24 Z" />
    </g>
</svg>
